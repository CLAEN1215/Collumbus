# Example settings only. Copy to .env if needed. NEVER put access keys or secrets here.
# Collumbus uses the standard AWS credential chain (aws configure / SSO profiles) instead.
#
# Name of a local AWS CLI profile with READ-ONLY permissions (used from Phase 5 onward).
AWS_PROFILE=collumbus-readonly
# Default region for AWS API calls. Scans still require explicit region selection.
AWS_DEFAULT_REGION=us-east-1
